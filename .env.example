# Copy to .env.local (never commit it) and fill in from
# Firebase console → Project settings → Your apps → Web app → SDK config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Payment server (Vercel environment variables; never VITE_ — never in the app).
# Razorpay Dashboard → Test Mode → Account & Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Razorpay Dashboard → Webhooks (events payment.captured, order.paid).
RAZORPAY_WEBHOOK_SECRET=
# Firebase console → Project settings → Service accounts → Generate new private key
# (paste the whole JSON on one line).
FIREBASE_SERVICE_ACCOUNT=

# Android app only: full URL of the deployed site that hosts /api.
VITE_API_BASE_URL=
